<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.goparamore</groupId>
    <artifactId>Lookup</artifactId>
    <version>1.0-SNAPSHOT</version>
  </parent>

  <artifactId>PriceConsumer</artifactId>

  <dependencies>
    <dependency>
      <groupId>io.goparamore</groupId>
      <artifactId>Model</artifactId>
      <version>1.0-SNAPSHOT</version>
    </dependency>
    <dependency>
      <groupId>io.goparamore</groupId>
      <artifactId>SimpleEventing</artifactId>
      <version>1.0-SNAPSHOT</version>
    </dependency>

    <!-- We maintain the copy, so we are one of the two modules that chooses SQLite. Model still
         does not: it declared IPriceStore and knows nothing about this line. -->
    <dependency>
      <groupId>io.goparamore</groupId>
      <artifactId>LocalCopy</artifactId>
      <version>1.0-SNAPSHOT</version>
    </dependency>

    <dependency>
      <groupId>org.apache.kafka</groupId>
      <artifactId>kafka-clients</artifactId>
      <version>${kafka.version}</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <version>${slf4j.version}</version>
      <scope>runtime</scope>
    </dependency>
  </dependencies>

  <build>
    <!-- So the jar is at PriceConsumer/target/PriceConsumer.jar, which is short enough to type and
         short enough for 'pgrep -f PriceConsumer.jar' to find. -->
    <finalName>PriceConsumer</finalName>
    <plugins>
      <!-- An executable jar plus its dependencies in target/lib, rather than one fat jar:
           it builds in a fraction of the time and 'java -jar' works either way. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <archive>
            <manifest>
              <mainClass>priceconsumer.PriceConsumer</mainClass>
              <addClasspath>true</addClasspath>
              <classpathPrefix>lib/</classpathPrefix>
            </manifest>
          </archive>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <id>copy-dependencies</id>
            <phase>prepare-package</phase>
            <goals><goal>copy-dependencies</goal></goals>
            <configuration>
              <outputDirectory>${project.build.directory}/lib</outputDirectory>
              <includeScope>runtime</includeScope>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
